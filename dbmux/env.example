# DBMux Environment Configuration Example

# Master Auth Keys (Supabase-Style API Keys)
# DBMUX_ANON_KEY: Public key for frontend applications (enforces RLS and requires user JWT)
DBMUX_ANON_KEY=dbmux_anon_public_key_demo123

# DBMUX_SERVICE_ROLE_KEY: Secret key for backend/admin services (bypasses RLS for admin operations)
DBMUX_SERVICE_ROLE_KEY=dbmux_service_role_secret_admin_key_demo123

# DBMUX_JWT_SECRET: HMAC-SHA256 secret key to sign and verify user JWT authentication tokens
DBMUX_JWT_SECRET=super_secret_jwt_key_change_me_in_production

# --- Optional Pre-Configured Provider DSNs & Tokens ---
# You can pre-configure default database connection strings or tokens in environment variables.
# dbmux automatically registers these providers at startup if set.

# PostgreSQL / Neon / Supabase DSN (or token)
POSTGRES_DSN=postgresql://user:password@ep-neon-123.neon.tech/neondb?sslmode=require

# MySQL / Scaleway / OVH DSN
MYSQL_DSN=user:password@tcp(mysql-host:3306)/mydb

# SQLite / Turso DSN (URL + Auth Token)
SQLITE_DSN=libsql://my-db.turso.io?authToken=my_turso_jwt_token

# MongoDB Atlas DSN
MONGO_DSN=mongodb+srv://user:password@cluster.mongodb.net/mydb

# Redis / Valkey DSN
REDIS_DSN=redis://:redis_password@redis-host:6379

# Vector (Qdrant / Pgvector) DSN
VECTOR_DSN=https://cluster.qdrant.tech:6334?api_key=my_qdrant_key

# Cloud IMDS Provider Overrides (Optional: For Floci, LocalStack, or custom local testing)
AWS_METADATA_HOST=
GCP_METADATA_HOST=
AZURE_METADATA_HOST=
K8S_TOKEN_PATH=

# Provider Token Auth (Options: aws, gcp, azure, k8s, token, auto)
AUTH_PROVIDER=auto
AUTH_TOKEN=

# OpenTelemetry (OTel) Tracing Configuration (Optional: Grafana Tempo, SigNoz, Jaeger, Datadog)
# OTEL_EXPORTER_OTLP_ENDPOINT: e.g. http://localhost:4317 or http://signoz-collector.default.svc:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME: Service identifier for traces (default: dbmux)
OTEL_SERVICE_NAME=dbmux
# OTEL_EXPORTER_OTLP_TOKEN: Optional bearer token for cloud APMs (e.g. Grafana Cloud / Honeycomb)
OTEL_EXPORTER_OTLP_TOKEN=


