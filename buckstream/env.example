# Comma-separated list of allowed domains for CORS checks
ALLOWED_DOMAINS=localhost:3000,app.example.com

# --- IAM Authentication (Keyless Cloud Hosting) ---
# Set S3_BY_IAM=true if running on AWS (ECS, EC2, Lambda) using IAM Task/Instance Roles
S3_BY_IAM=false

# Set GCS_BY_IAM=true if running on GCP (Cloud Run, GKE) using Application Default Credentials / Service Accounts
GCS_BY_IAM=false

# --- S3-Compatible Token Authentication (Static Keys) ---
# Set S3_COMPATIBLE_BY_TOKEN=true to use static API credentials with any S3-compatible provider
# (e.g. Cloudflare R2, Wasabi, MinIO). Leave blank if using LOCAL_S3_DIR or IAM.
S3_COMPATIBLE_BY_TOKEN=false
S3_COMPATIBLE_ENDPOINT=
S3_COMPATIBLE_REGION=us-east-1
S3_COMPATIBLE_ACCESS_KEY=
S3_COMPATIBLE_ACCESS_SECRET=

# --- Local Persistent Volume Storage ---
# Set LOCAL_S3=true to use the local filesystem as storage.
# Works for local development AND self-hosted production with a mounted PV (e.g. Kubernetes PVC).
# Defaults storage to ./tmp/local_s3. For prod, uncomment LOCAL_S3_DIR and set your PV mount path.
# Takes priority over S3/GCS providers when true. Set to false to fall back to cloud storage.
LOCAL_S3=false
# LOCAL_S3_DIR=/mnt/data

# --- Storage Settings ---
# The default bucket name used for storing site assets and media
BUCKET_NAME=buckstream

# --- Security Settings ---
# Token for deploying static sites (GitHub Actions, CLI, developers)
DEPLOY_TOKEN=

# Token for normal client-side runtime uploads (media, avatars)
UPLOAD_TOKEN=

# --- Cache Settings ---
# The maximum number of static site deployments to cache in memory (LRU)
MAX_CACHED_SITES=10
