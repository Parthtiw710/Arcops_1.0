# ==============================================================================
# ArcOps OSS Single-User Deployment Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GATEWAY CONFIGURATION & ADMIN EMAILS
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
ADMIN_EMAILS=admin@arcops.local,owner@myorg.com
ARCOPS_ADMIN_KEY=admin_secret_token_123
ARCOPS_ANON_KEY=anon_secret_token_123
ARCOPS_SANDBOX_KEY=sbx_secret_token_123

# Rate Limiting
RATE_LIMIT_PER_SEC=30
RATE_BURST=60

# JWT & Session Secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ------------------------------------------------------------------------------
# 2. DBMUX DATA ENGINE — DATABASE DRIVERS (SQL, NoSQL, KV, Vector)
# ------------------------------------------------------------------------------
POSTGRES_DB=arcops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DBMUX_POSTGRES_DSN=postgres://postgres:postgrespassword@postgres:5432/arcops?sslmode=disable
POSTGRES_DSN=postgres://postgres:postgrespassword@postgres:5432/arcops?sslmode=disable

# Additional SQL / NoSQL Database DSNs
MYSQL_DSN=root:secret@tcp(mysql-host:3306)/arcops
MONGO_DSN=mongodb://root:secret@mongo-host:27017/arcops?authSource=admin
SQLITE_DSN=file:arcops.db?cache=shared&mode=rwc
SQLITE_DATA_DIR=/data/sqlite

# KV & Vector
REDIS_DSN=redis://redis:6379/0
PGVECTOR_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Cloud DB Authentication / IAM Providers (aws | gcp | azure | k8s | static)
AUTH_PROVIDER=
AWS_METADATA_HOST=169.254.169.254
GCP_METADATA_HOST=metadata.google.internal
AZURE_METADATA_HOST=169.254.169.254
K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
AUTH_TOKEN=

# OpenTelemetry Exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=dbmux
OTEL_EXPORTER_OTLP_TOKEN=

# ------------------------------------------------------------------------------
# 3. BUCKSTREAM S3 OBJECT STORAGE (Local / AWS / GCS / Azure / Custom S3)
# ------------------------------------------------------------------------------
# Storage Mode: "local" or "s3_compatible" or "s3" or "gcs" or "azure"
LOCAL_S3=true
LOCAL_S3_DIR=/data/storage
BUCKET_NAME=arcops

# AWS S3 / S3-Compatible Cloud Storage
S3_COMPATIBLE_ENDPOINT=https://s3.us-west-2.amazonaws.com
S3_COMPATIBLE_ACCESS_KEY=your_aws_access_key
S3_COMPATIBLE_ACCESS_SECRET=your_aws_secret_key
AWS_REGION=us-west-2

# Google Cloud Storage (GCS)
GCS_BUCKET_NAME=arcops-gcs-bucket
GCS_SERVICE_ACCOUNT_EMAIL=sa@project.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-key.json

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=arcopsstorage
AZURE_STORAGE_KEY=your_azure_storage_key
AZURE_CONTAINER_NAME=arcops-container

# ------------------------------------------------------------------------------
# 4. ARCAUTH SERVICE (Email, SMS OTP, OAuth Providers)
# ------------------------------------------------------------------------------
# Email Provider: mock | smtp | resend
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=secret
SMTP_FROM=noreply@example.com
RESEND_API_KEY=re_123456789
RESEND_FROM=onboarding@resend.dev

# SMS Provider: mock | twilio | twilio_verify | messagebird | vonage | textlocal
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC123456789
TWILIO_AUTH_TOKEN=secret
TWILIO_FROM_PHONE=+1234567890
MESSAGEBIRD_ACCESS_KEY=key_123
VONAGE_API_KEY=key_123
VONAGE_API_SECRET=secret

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# Google OAuth App Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# Security Rules
SOCIAL_NO_NEW=false
DISABLE_SOCIAL_SIGNUP=false

# ------------------------------------------------------------------------------
# 5. FRONTEDGE DEPLOYER (Cloudflare Pages + GitHub Repos)
# ------------------------------------------------------------------------------
GITHUB_PAT=github_pat_11AAAAAAA_xxx
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_api_token
